# Backend Environment Variables
# Copy to .env and fill in values

# Application
APP_NAME="Quant Trading System"
APP_VERSION="1.0.0"
DEBUG=false

# API
API_PREFIX="/api"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,https://your-frontend.vercel.app"

# Database (optional, for future use)
# DATABASE_URL=postgresql://user:pass@host:5432/quant

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379

# External Data APIs
# SETSMART_API_KEY=your_api_key_here
# BLOOMBERG_API_KEY=your_api_key_here

# Authentication
AUTH_SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRE_MINUTES=60

# Report Generation
# WEASYPRINT_ENABLED=true
